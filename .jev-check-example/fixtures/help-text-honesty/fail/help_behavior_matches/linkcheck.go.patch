+package main
+
+import (
+	"fmt"
+	"os"
+)
+
+const linkUsage = `Usage: linkcheck FILE...
+Checks every link in the files.
+Exit status: 0 when every link works, 1 when a link is broken.
+`
+
+func main() {
+	if len(os.Args) < 2 {
+		fmt.Fprint(os.Stderr, linkUsage)
+		os.Exit(2)
+	}
+	broken := 0
+	for _, f := range os.Args[1:] {
+		broken += checkFile(f)
+	}
+	if broken > 0 {
+		fmt.Fprintf(os.Stderr, "%d broken links\n", broken)
+		os.Exit(4)
+	}
+}
