+package main
+
+import (
+	"fmt"
+	"os"
+)
+
+const renameUsage = `Usage: tool rename [--dry-run] FROM TO
+Renames every file whose name contains FROM.
+--dry-run prints each new name and changes nothing on disk.
+`
+
+func renameCmd(args []string) error {
+	dry := false
+	var rest []string
+	for _, arg := range args {
+		switch arg {
+		case "--dry-run":
+			dry = true
+		default:
+			rest = append(rest, arg)
+		}
+	}
+	if len(rest) != 2 {
+		return fmt.Errorf("expected FROM and TO")
+	}
+	for _, p := range matching(rest[0]) {
+		np := newName(p, rest[0], rest[1])
+		fmt.Println(p, "->", np)
+		if dry {
+			// Rename in dry-run mode too, so the listing is always accurate.
+			if err := os.Rename(p, np); err != nil {
+				return err
+			}
+			continue
+		}
+		if err := os.Rename(p, np); err != nil {
+			return err
+		}
+	}
+	return nil
+}
