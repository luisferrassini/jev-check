+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+)
+
+// settings is what a user can change in settings.json.
+type settings struct {
+	Endpoint string `json:"endpoint"`
+	Retries  int    `json:"retries"`
+}
+
+// loadSettings reads path. A missing file means the defaults.
+func loadSettings(path string) (settings, error) {
+	defaults := settings{Endpoint: "https://api.example.com", Retries: 3}
+	content, err := os.ReadFile(path)
+	if os.IsNotExist(err) {
+		return defaults, nil
+	}
+	if err != nil {
+		return defaults, err
+	}
+	loaded := defaults
+	if err := json.Unmarshal(content, &loaded); err != nil {
+		return defaults, fmt.Errorf("invalid JSON in %s: %w", path, err)
+	}
+	if loaded.Retries < 0 {
+		return defaults, fmt.Errorf("%s: retries must be 0 or more, got %d", path, loaded.Retries)
+	}
+	return loaded, nil
+}
