+package main
+
+import (
+	"bytes"
+	"errors"
+	"net/http"
+	"os"
+)
+
+// uploadReport sends the report file to the review server.
+func uploadReport(serverURL, reportPath string) error {
+	report, err := os.ReadFile(reportPath)
+	if err != nil {
+		return errors.New("failed")
+	}
+	response, err := http.Post(serverURL, "application/json", bytes.NewReader(report))
+	if err != nil {
+		return errors.New("failed")
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return errors.New("error")
+	}
+	return nil
+}
