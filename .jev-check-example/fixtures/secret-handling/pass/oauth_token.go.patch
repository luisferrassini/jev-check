+package auth
+
+import (
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+const tokenURL = "https://login.example.com/oauth2/token"
+
+// FetchToken exchanges the client credentials for an access token.
+func FetchToken(clientID, clientSecret string) (*http.Response, error) {
+	form := url.Values{
+		"grant_type":    {"client_credentials"},
+		"client_id":     {clientID},
+		"client_secret": {clientSecret},
+	}
+	return http.Post(tokenURL, "application/x-www-form-urlencoded", strings.NewReader(form.Encode()))
+}
