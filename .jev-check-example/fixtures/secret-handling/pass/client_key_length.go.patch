+package api
+
+import (
+	"log"
+	"os"
+)
+
+// NewClient reads the key from the environment and reports only whether it is set.
+func NewClient() (*Client, error) {
+	apiKey := os.Getenv("SERVICE_API_KEY")
+	if apiKey == "" {
+		log.Printf("SERVICE_API_KEY is not set; requests will be anonymous")
+		return &Client{}, nil
+	}
+	log.Printf("loaded SERVICE_API_KEY (%d characters)", len(apiKey))
+	return &Client{apiKey: apiKey}, nil
+}
