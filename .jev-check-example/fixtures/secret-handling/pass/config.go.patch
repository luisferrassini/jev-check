+package config
+
+import (
+	"errors"
+	"fmt"
+	"os"
+)
+
+type Config struct {
+	Endpoint string
+	Password string
+}
+
+// String hides the password so a Config is safe to log.
+func (c Config) String() string {
+	return fmt.Sprintf("endpoint=%s password=[redacted]", c.Endpoint)
+}
+
+func Load() (Config, error) {
+	c := Config{Endpoint: os.Getenv("DB_ENDPOINT"), Password: os.Getenv("DB_PASSWORD")}
+	if c.Password == "" {
+		return c, errors.New("DB_PASSWORD is not set")
+	}
+	return c, nil
+}
