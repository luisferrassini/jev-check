diff --git a/scripts/whoami.sh b/scripts/whoami.sh
new file mode 100644
index 0000000..7d04c93
--- /dev/null
+++ b/scripts/whoami.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [ -z "${GITHUB_TOKEN:-}" ]; then
+  echo "GITHUB_TOKEN is not set" >&2
+  exit 1
+fi
+echo "GITHUB_TOKEN is set (${#GITHUB_TOKEN} characters)" >&2
+curl -fsS -H "Authorization: Bearer $GITHUB_TOKEN" https://api.github.com/user
