+const FIRST_PAGE = "https://api.example.com/v2/items";
+
+export async function fetchAll(token) {
+  const items = [];
+  let url = FIRST_PAGE;
+  while (url) {
+    const res = await fetch(url, { headers: { Authorization: `Bearer ${token}` } });
+    const body = await res.json();
+    items.push(...body.items);
+    url = body.next_url;
+  }
+  return items;
+}
