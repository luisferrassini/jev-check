+package report
+
+import (
+	"net/http"
+	"os"
+)
+
+// Upload sends the report to the URL in REPORT_URL.
+func Upload(r *Report) error {
+	endpoint := os.Getenv("REPORT_URL")
+	req, err := http.NewRequest(http.MethodPost, endpoint, r.Reader())
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Authorization", "Bearer "+os.Getenv("REPORT_TOKEN"))
+	_, err = http.DefaultClient.Do(req)
+	return err
+}
