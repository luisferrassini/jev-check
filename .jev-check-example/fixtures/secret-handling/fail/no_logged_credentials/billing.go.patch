+package billing
+
+import (
+	"log"
+	"net/http"
+)
+
+const chargeURL = "https://billing.example.com/v1/charges"
+
+func (c *Client) Charge(amount int) error {
+	log.Printf("charging %d with api key %s", amount, c.apiKey)
+	req, err := http.NewRequest(http.MethodPost, chargeURL, amountBody(amount))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("X-Api-Key", c.apiKey)
+	_, err = http.DefaultClient.Do(req)
+	return err
+}
