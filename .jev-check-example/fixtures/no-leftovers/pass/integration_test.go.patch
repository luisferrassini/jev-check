 }
+
+func TestPostgresRoundTrip(t *testing.T) {
+	if testing.Short() {
+		t.Skip("integration test; run without -short")
+	}
+	dsn := os.Getenv("TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("TEST_POSTGRES_DSN is not set")
+	}
+	s := openPostgres(t, dsn)
+	defer s.Close()
+}
