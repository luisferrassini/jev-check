+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+)
+
+// printChecks writes the check results. With --json, stdout holds only the JSON report,
+// so other programs can parse it.
+func printChecks(report Report, jsonMode bool) error {
+	if jsonMode {
+		if err := json.NewEncoder(os.Stdout).Encode(report); err != nil {
+			return err
+		}
+		fmt.Printf("debug: wrote %d checks\n", len(report.Checks))
+		return nil
+	}
+	for _, c := range report.Checks {
+		fmt.Printf("%s: %s\n", c.Name, c.Status)
+	}
+	return nil
+}
