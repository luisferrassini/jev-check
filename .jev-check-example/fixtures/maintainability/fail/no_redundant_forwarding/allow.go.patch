+package main
+
+import (
+	"fmt"
+	"slices"
+)
+
+func checkAllowed(allowed []string, host string) error {
+	contains := func(list []string, item string) bool { return slices.Contains(list, item) }
+	if !contains(allowed, host) {
+		return fmt.Errorf("host %s is not in the allow list", host)
+	}
+	return nil
+}
