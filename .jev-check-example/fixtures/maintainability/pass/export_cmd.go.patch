+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+)
+
+// runExport writes the items as JSON. Scripts read stdout, so stdout holds only JSON;
+// progress goes to stderr.
+func runExport(items []Item) error {
+	fmt.Fprintf(os.Stderr, "exporting %d items...\n", len(items))
+	return json.NewEncoder(os.Stdout).Encode(items)
+}
