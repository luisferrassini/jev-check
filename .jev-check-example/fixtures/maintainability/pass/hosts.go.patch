+package main
+
+import (
+	"fmt"
+	"slices"
+)
+
+func checkAllowed(allowed []string, host, proxy string) error {
+	contains := func(list []string, item string) bool { return slices.Contains(list, item) }
+	if !contains(allowed, host) {
+		return fmt.Errorf("host %s is not in the allow list", host)
+	}
+	if proxy != "" && !contains(allowed, proxy) {
+		return fmt.Errorf("proxy %s is not in the allow list", proxy)
+	}
+	return nil
+}
