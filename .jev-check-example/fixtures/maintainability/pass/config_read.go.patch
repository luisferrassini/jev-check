+package main
+
+import (
+	"os"
+	"path/filepath"
+)
+
+// readConfig reads config.json from a project folder.
+func readConfig(dir string) ([]byte, error) {
+	return os.ReadFile(filepath.Join(dir, "config.json"))
+}
+
+func projectName(dir string) (string, error) {
+	data, err := readConfig(dir)
+	if err != nil {
+		return "", err
+	}
+	return parseName(data)
+}
