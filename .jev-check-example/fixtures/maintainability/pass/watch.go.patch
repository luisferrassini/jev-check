+package main
+
+import (
+	"context"
+	"net"
+)
+
+// serve handles one connection and closes it when ctx is canceled.
+func serve(ctx context.Context, conn net.Conn) error {
+	stop := context.AfterFunc(ctx, func() {
+		conn.Close()
+	})
+	defer stop()
+	return handle(conn)
+}
