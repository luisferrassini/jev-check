+package main
+
+import (
+	"fmt"
+	"io"
+)
+
+func printSummary(w io.Writer, name string, passed, failed int) {
+	format := func(pattern string, args ...any) string { return "  " + fmt.Sprintf(pattern, args...) }
+	fmt.Fprintln(w, format("%s: %d passed, %d failed", name, passed, failed))
+}
