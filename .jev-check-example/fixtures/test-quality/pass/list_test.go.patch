+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestListShowsBundledChecks(t *testing.T) {
+	setup(t)
+	out := wantCode(t, 0, "list")
+	for _, name := range []string{"public-release", "example"} {
+		if !strings.Contains(out, name+" [bundled") {
+			t.Errorf("list: no %s in:\n%s", name, out)
+		}
+	}
+	wantCode(t, 2, "list", "a", "b")
+}
