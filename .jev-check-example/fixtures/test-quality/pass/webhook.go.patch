+package notify
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+)
+
+// Send posts message to the team webhook.
+func Send(message string) error {
+	resp, err := http.Post("https://hooks.example.com/team", "text/plain", strings.NewReader(message))
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode >= 300 {
+		return fmt.Errorf("webhook: status %s", resp.Status)
+	}
+	return nil
+}
