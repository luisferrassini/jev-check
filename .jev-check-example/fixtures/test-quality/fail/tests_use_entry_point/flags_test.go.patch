+package main
+
+import "testing"
+
+func TestParseFlags(t *testing.T) {
+	opts, err := parseFlags([]string{"--json", "--limit", "5", "scan"})
+	if err != nil {
+		t.Fatalf("parseFlags(--json --limit 5 scan): %v", err)
+	}
+	if !opts.JSON || opts.Limit != 5 || opts.Command != "scan" {
+		t.Errorf("parseFlags(--json --limit 5 scan) = %+v, want JSON, limit 5, command scan", opts)
+	}
+}
