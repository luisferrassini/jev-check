+package lexer
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestSplitTokens(t *testing.T) {
+	tests := []struct {
+		in   string
+		want []string
+	}{
+		{"a + b", []string{"a", "+", "b"}},
+		{"(x)", []string{"(", "x", ")"}},
+	}
+	for _, tc := range tests {
+		if got := splitTokens(tc.in); !slices.Equal(got, tc.want) {
+			t.Errorf("splitTokens(%q) = %q, want %q", tc.in, got, tc.want)
+		}
+	}
+}
