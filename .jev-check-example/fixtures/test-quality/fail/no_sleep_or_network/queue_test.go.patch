+package queue
+
+import (
+	"testing"
+	"time"
+)
+
+func TestConsumerDrains(t *testing.T) {
+	q := New()
+	go q.Consume()
+	q.Push("a")
+	q.Push("b")
+	time.Sleep(500 * time.Millisecond)
+	if n := q.Len(); n != 0 {
+		t.Errorf("queue after pushing a and b: len %d, want 0", n)
+	}
+}
