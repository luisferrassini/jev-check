+package release
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestLatestTag(t *testing.T) {
+	resp, err := http.Get("https://api.github.com/repos/golang/go/releases/latest")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	tag, err := ParseLatest(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tag == "" {
+		t.Errorf("ParseLatest of the GitHub response: empty tag")
+	}
+}
