+package main
+
+import "errors"
+
+// validateAccount checks the fields a new account needs against the site's rules.
+func validateAccount(rules Rules, account Account) error {
+	check := func(field, value string) error {
+		return rules.Validate(field, value)
+	}
+	return errors.Join(
+		check("name", account.Name),
+		check("email", account.Email),
+		check("country", account.Country),
+	)
+}
