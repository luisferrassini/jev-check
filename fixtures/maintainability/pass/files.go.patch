+package main
+
+import "os"
+
+// withFile opens path, runs fn on it, and always closes it.
+func withFile(path string, fn func(*os.File) error) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	return fn(f)
+}
