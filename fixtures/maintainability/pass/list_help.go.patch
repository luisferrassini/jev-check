+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+)
+
+const listUsage = `Usage: tool list [--help]
+Prints the checks as a JSON array on stdout, and nothing else.`
+
+func listCmd(args []string, checks []Check) error {
+	if len(args) > 0 && args[0] == "--help" {
+		fmt.Println(listUsage)
+		return nil
+	}
+	return json.NewEncoder(os.Stdout).Encode(checks)
+}
